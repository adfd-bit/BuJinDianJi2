{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Build Firmware (CMake)",
            "type": "shell",
            "command": "cmake",
            "args": [
                "--workflow",
                "--preset",
                "debug"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "problemMatcher": [
                "$gcc"
            ]
        },
        {
            "label": "Clean Firmware (CMake)",
            "type": "shell",
            "command": "cmake",
            "args": [
                "--build",
                "--preset",
                "debug",
                "--target",
                "clean"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": []
        },
        {
            "label": "Build Firmware (legacy Makefile)",
            "type": "shell",
            "command": "${workspaceFolder}/build-makefile.bat",
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": [
                "$gcc"
            ]
        }
    ]
}
